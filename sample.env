# Copy to .env and adjust values (never commit .env).
#   copy sample.env .env

# --- Florence-2 / device ---
FLORENCE_MODEL_ID=microsoft/Florence-2-base
# cuda | cpu — leave commented to auto-pick cuda when available
# DEVICE=cuda

# --- Tiling (OCR / VLM / hybrid) ---
TILE_SIZE_PX=400
STRIDE_RATIO=0.2
DEDUP_IOU_THRESHOLD=0.5

# --- Tile debug overlays ---
SAVE_TILE_OVERLAYS=true
TILE_OVERLAY_MAX_SAVES=60

# --- VLM inference (VRAM) ---
TILE_BATCH_SIZE=1
VLM_NUM_BEAMS=1
VLM_MAX_NEW_TOKENS=256

# --- Qwen3 text reasoning filter (post-VLM false-positive removal) ---
ENABLE_REASONING_FILTER=false
QWEN3_TEXT_MODEL_ID=Qwen/Qwen3-4B
# Optional Hugging Face token for gated models (use one of the two)
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=
REASONING_FILTER_PROMPT_FILE=app/filter_prompt.txt
REASONING_MAX_NEW_TOKENS=2048
SAVE_REASONING_INTERMEDIATE=true
REASONING_INTERMEDIATE_MAX_ITEMS=4000

# --- OCR ---
DEFAULT_OCR_ENGINE=paddle

# --- Preprocessing ---
MAX_IMAGE_DIM=2400
ENABLE_ENHANCE=false
PDF_DPI=200

# --- Hybrid clustering ---
HORIZONTAL_GAP_RATIO=0.5
VERTICAL_OVERLAP_RATIO=0.6
CLUSTER_PADDING_PX=4
MIN_CLUSTER_SIZE=2
